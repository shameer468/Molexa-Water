{
    "functions": {
        "backend/server.js": {
            "runtime": "nodejs20.x"
        }
    },
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "dist/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/",
            "dest": "dist/index.html"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
            "dest": "dist/$1"
        },
        {
            "src": "/(.*)",
            "dest": "dist/index.html"
        }
    ]
}